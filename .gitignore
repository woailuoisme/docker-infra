# ==============================================================================
# Docker Infrastructure Git 忽略规则 (.gitignore)
# ==============================================================================

# --- 1. 环境配置与敏感凭据 (Environment & Secrets) ---
.env
.env.*
!.env.example
*.ini
*.pem
*.key
*.crt

# 容器认证私钥与凭据
**/mosquitto/config/passwd
**/traefik/acme/*.json
acme.json
open-bao/.keys.json
open-bao/.approle-credentials.txt


# --- 2. 宿主机持久化数据与运行时日志 (Data & Logs) ---
/data/
data/
/logs/
logs/
/backup/
backup/
*.dump
*.sql.gz
*.backup
*.sqlite3
*.db

# --- 3. 编辑器与 IDE 配置 (IDEs & System) ---
.DS_Store
**/.DS_Store
.idea/
.zed/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# AI 编码助手工作区配置
.claude/
.agents/
.agent/
.codebuddy/
.qoder/
.kiro/

# --- 4. 临时文件与静态检查缓存 (Caches & Temps) ---
.rumdl_cache/
*.tmp
*.log
