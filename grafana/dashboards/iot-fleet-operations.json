        "view": {
          "allLayers": true,
          "id": "coords",
          "lat": 26,
          "lon": 115,
          "zoom": 5
        }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB3-SQL" },
          "format": "table",
          "rawSql": "SELECT device_no, MAX(lat) as lat, MAX(lng) as lng, ROUND(AVG(temp_zone_0), 1) as \"温区0仓温 (°C)\", ROUND(AVG(ambient_temp), 1) as \"环境温度 (°C)\", CASE WHEN MIN(CASE WHEN door_closed THEN 1 ELSE 0 END) = 1 THEN '安全闭合' ELSE '未闭合/告警' END as \"柜门状态\", ROUND(MAX(vibration_g), 3) as \"最大振动 (g)\", CASE WHEN AVG(temp_zone_0) > -10.0 OR MIN(CASE WHEN door_closed THEN 1 ELSE 0 END) = 0 OR MAX(vibration_g) > 0.08 THEN 2 WHEN AVG(temp_zone_0) > -16.0 OR MAX(vibration_g) > 0.04 THEN 1 ELSE 0 END as health_status FROM vm_telemetry WHERE $__timeFilter(time) GROUP BY device_no",
          "refId": "A"
        }
      ]
    },
