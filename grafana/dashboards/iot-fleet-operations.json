      "title": "机群核心冷链平均仓温 (Avg Freezer Temp)",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "InfluxDB3-SQL" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": -18 },
              { "color": "orange", "value": -12 },
              { "color": "red", "value": -5 }
            ]
          },
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB3-SQL" },
          "format": "table",
          "rawSql": "SELECT time, AVG((temp_zone_0 + temp_zone_1 + temp_zone_2 + temp_zone_3) / 4.0) as avg_temp FROM vm_telemetry WHERE $__timeFilter(time) GROUP BY time ORDER BY time ASC",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "机群柜门安全闭合率 (Door Safety)",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "InfluxDB3-SQL" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "index": 0, "text": "存在异常未闭合" },
                "1": { "color": "green", "index": 1, "text": "全部安全闭合 (Normal)" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "door_status", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB3-SQL" },
          "format": "table",
          "rawSql": "SELECT time, CASE WHEN MIN(CASE WHEN door_closed THEN 1 ELSE 0 END) = 1 THEN 1 ELSE 0 END as door_status FROM vm_telemetry WHERE $__timeFilter(time) GROUP BY time ORDER BY time DESC LIMIT 1",
          "refId": "A"
        }
      ]
    },
