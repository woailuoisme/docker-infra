# 1. 全局配置 (Global)
APP_ENV=production
TIMEZONE=Asia/Shanghai
SITE_ADDRESS=test.local
DATA_PATH=/Users/seaside/Projects/devops/docker/docker-infra/data/
LOG_PATH=/Users/seaside/Projects/devops/docker/docker-infra/logs/

# 2. 网关与 DNS (Traefik & ACME)
AUTHELIA_HOST=authelia:9091
CF_API_TOKEN=your_cloudflare_api_token_here
LEGO_EMAIL=admin@example.com

# 3. 安全防御 (CrowdSec)
CROWDSEC_BOUNCER_KEY=replace_with_crowdsec_traefik_bouncer_api_key
CROWDSEC_LAPI_HOST=crowdsec:8080
CROWDSEC_APPSEC_HOST=crowdsec:7422

# 4. 身份认证 (Authelia)
AUTHELIA_JWT_SECRET=replace_with_authelia_jwt_secret_min_64_chars_hex
AUTHELIA_SESSION_SECRET=replace_with_authelia_session_secret_min_32_chars
AUTHELIA_STORAGE_ENCRYPTION_KEY=replace_with_authelia_storage_encryption_key_min_32_chars
RESEND_API_KEY=re_your_resend_api_key_here

# 5. 数据库与缓存 (Postgres & Valkey)
POSTGRES_DB=lunchbox
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_postgres_secure_password
TIMESCALE_DATABASES=lunchbox
ENABLE_IOT_VENDING_SCHEMA=false
REDIS_PASSWORD=replace_with_valkey_secure_password

# 6. 对象存储 (Garage S3)
GARAGE_DEFAULT_ACCESS_KEY=GK_replace_with_garage_access_key
GARAGE_DEFAULT_SECRET_KEY=replace_with_garage_secret_key_hex_64_chars
GARAGE_RPC_SECRET=replace_with_garage_rpc_secret_hex_64_chars
GARAGE_ADMIN_TOKEN=replace_with_garage_admin_token_base64
GARAGE_METRICS_TOKEN=replace_with_garage_metrics_token_base64

# 7. 实时消息 (Centrifugo & Mosquitto)
CENTRIFUGO_API_KEY=replace_with_centrifugo_api_key_uuid
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=replace_with_centrifugo_token_hmac_secret_uuid
CENTRIFUGO_ADMIN_PASSWORD=replace_with_centrifugo_admin_password
CENTRIFUGO_ADMIN_SECRET=replace_with_centrifugo_admin_secret
MQTT_USERNAME=admin
MQTT_PASSWORD=replace_with_mosquitto_secure_password

# 8. 检索与媒体 (Meilisearch & imgproxy)
MEILI_MASTER_KEY=replace_with_meilisearch_master_key_16_chars_min
IMGPROXY_KEY=replace_with_imgproxy_hex_key_32_bytes
IMGPROXY_SALT=replace_with_imgproxy_hex_salt_32_bytes

# 9. 可观测性 (OpenObserve & OTel Collector)
OPENOBSERVE_ROOT_EMAIL=admin@example.com
OPENOBSERVE_ROOT_PASSWORD=Replace_With_OpenObserve_Admin_Password123!
O2_AUTH="Basic YWRtaW5AZXhhbXBsZS5jb206UmVwbGFjZV9XaXRoX09wZW5PYnNlcnZlX0FkbWluX1Bhc3N3b3JkMTIzIQ=="

# 10. 监控看板与统一门户 (Beszel, Homepage, Gatus)
BESZEL_AGENT_KEY="replace_with_beszel_agent_public_key"
BESZEL_AGENT_TOKEN="replace_with_beszel_agent_token"
BESZEL_HUB_URL=http://127.0.0.1:8090

# 11. 网站分析与用户行为洞察 (Umami)
UMAMI_APP_SECRET=replace_with_umami_app_secret_random_hex_32_chars

# 12. IoT 物联网与时序引擎 (InfluxDB 3 & Telegraf)
INFLUXDB_DATABASE=iot
INFLUXDB_TOKEN=replace_with_influxdb_secure_token_or_apiv3_token

# 13. 统一时序数据监控与可视化看板 (Grafana 13.x)
GRAFANA_ADMIN_PASSWORD=replace_with_grafana_admin_secure_password




